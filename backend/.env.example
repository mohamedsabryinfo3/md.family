# MD.Family Backend — Environment configuration for PRODUCTION
# ============================================================
# Copy this file to `.env` and fill in the values.
# All variables use the MDFAMILY_ prefix to avoid collisions.

# ─── App ─────────────────────────────────────────────
MDFAMILY_APP_ENV=production
MDFAMILY_APP_DEBUG=false
MDFAMILY_APP_HOST=0.0.0.0
MDFAMILY_APP_PORT=8000
MDFAMILY_APP_LOG_LEVEL=info

# ─── Database (PostgreSQL — required for production) ──
# On Render.com: this is set automatically from the database service
# On your own server: use your PostgreSQL connection string
MDFAMILY_DATABASE_URL=postgresql+psycopg2://mdfamily:password@localhost:5432/mdfamily

# ─── Redis ───────────────────────────────────────────
# On Render.com: this is set automatically from the Redis service
# On your own server: redis://localhost:6379/0
MDFAMILY_REDIS_URL=redis://localhost:6379/0

# ─── Security ────────────────────────────────────────
# IMPORTANT: Generate a strong secret for production!
# Run: python -c "import secrets; print(secrets.token_urlsafe(64))"
MDFAMILY_JWT_SECRET=CHANGE-ME-TO-A-VERY-LONG-RANDOM-STRING
MDFAMILY_JWT_ALGORITHM=HS256
MDFAMILY_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
MDFAMILY_JWT_REFRESH_TOKEN_EXPIRE_DAYS=90
MDFAMILY_BCRYPT_ROUNDS=12

# ─── Google OAuth (optional) ────────────────────────
# Get these from https://console.cloud.google.com/apis/credentials
MDFAMILY_GOOGLE_CLIENT_ID=
MDFAMILY_GOOGLE_CLIENT_SECRET=
MDFAMILY_GOOGLE_OAUTH_REDIRECT_URL=https://your-api-url.com/api/v1/auth/google/callback

# ─── Firebase Cloud Messaging ────────────────────────
# Download the service account JSON from Firebase Console:
# Project Settings → Service Accounts → Generate new private key
# Then paste the FULL JSON content here (Render supports multi-line env vars)
MDFAMILY_FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Pairing ────────────────────────────────────────
MDFAMILY_PAIRING_CODE_TTL_SECONDS=300
MDFAMILY_PAIRING_CODE_LENGTH=6

# ─── CORS ───────────────────────────────────────────
# Comma-separated list of allowed origins
# After deploying, add your frontend URL here
MDFAMILY_CORS_ORIGINS=*

# ─── Rate limiting ──────────────────────────────────
MDFAMILY_RATE_LIMIT_PER_MINUTE=120

# ─── Backup encryption ───────────────────────────────
MDFAMILY_BACKUP_ENCRYPTION_KEY=
